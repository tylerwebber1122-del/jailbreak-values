function addRow(side){
 const row=document.createElement("div");row.className="trade-row";const sel=document.createElement("select");sel.setAttribute("aria-label",side+" item");sel.innerHTML='<option value="">Choose an item</option>'+data.map((x,i)=>`<option value="${i}">${x.name} · ${money(x.value)}</option>`).join("");
 const remove=document.createElement("button");remove.className="btn secondary small";remove.textContent="×";remove.setAttribute("aria-label","Remove item");sel.addEventListener("change",update);remove.addEventListener("click",()=>{row.remove();update()});row.append(sel,remove);document.querySelector("#"+side).append(row);update();
}
function sum(side){return [...document.querySelectorAll("#"+side+" select")].reduce((n,s)=>n+(s.value===""?0:data[+s.value].value),0)}
function update(){const a=sum("give"),b=sum("get");document.querySelector("#giveTotal").textContent=money(a);document.querySelector("#getTotal").textContent=money(b);const v=document.querySelector("#verdict");if(!a&&!b)v.textContent="Add items to compare.";else if(a===b)v.textContent="Even by listed values.";else if(a>b)v.textContent="You're offering "+money(a-b)+" more in listed value.";else v.textContent="You're receiving "+money(b-a)+" more in listed value."}
document.querySelector("#addGive").addEventListener("click",()=>addRow("give"));document.querySelector("#addGet").addEventListener("click",()=>addRow("get"));addRow("give");addRow("get");
</script></body></html>
